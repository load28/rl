{
  "overview": "<span style=\"color:#FF7B72\">import</span><span style=\"color:#79C0FF\"> *</span><span style=\"color:#FF7B72\"> as</span><span style=\"color:#E6EDF3\"> Result </span><span style=\"color:#FF7B72\">from</span><span style=\"color:#A5D6FF\"> \"@rl/std/result\"</span><span style=\"color:#E6EDF3\">;</span><br><br><span style=\"color:#FF7B72\">const</span><span style=\"color:#79C0FF\"> message</span><span style=\"color:#FF7B72\"> =</span><span style=\"color:#E6EDF3\"> input</span><br><span style=\"color:#FF7B72\">  |></span><span style=\"color:#E6EDF3\"> parse</span><br><span style=\"color:#FF7B72\">  |></span><span style=\"color:#E6EDF3\"> Result.</span><span style=\"color:#D2A8FF\">mapP</span><span style=\"color:#E6EDF3\">(format)</span><br><span style=\"color:#FF7B72\">  |></span><span style=\"color:#E6EDF3\"> (</span><span style=\"color:#FFA657\">result</span><span style=\"color:#FF7B72\"> =></span><span style=\"color:#FF7B72\"> match</span><span style=\"color:#E6EDF3\"> (result) {</span><br><span style=\"color:#79C0FF\">    Ok</span><span style=\"color:#E6EDF3\">(value) </span><span style=\"color:#FF7B72\">=></span><span style=\"color:#E6EDF3\"> value,</span><br><span style=\"color:#79C0FF\">    Err</span><span style=\"color:#E6EDF3\">(error) </span><span style=\"color:#FF7B72\">=></span><span style=\"color:#A5D6FF\"> `Error: ${</span><span style=\"color:#E6EDF3\">error</span><span style=\"color:#A5D6FF\">}`</span><span style=\"color:#E6EDF3\">,</span><br><span style=\"color:#E6EDF3\">  });</span>",
  "enum": "<span style=\"color:#FF7B72\">export</span><span style=\"color:#FF7B72\"> enum</span><span style=\"color:#FFA657\"> Result</span><span style=\"color:#E6EDF3\">&#x3C;</span><span style=\"color:#FFA657\">T</span><span style=\"color:#E6EDF3\">, </span><span style=\"color:#FFA657\">E</span><span style=\"color:#E6EDF3\">> {</span><br><span style=\"color:#79C0FF\">  Ok</span><span style=\"color:#E6EDF3\">(value</span><span style=\"color:#FF7B72\">:</span><span style=\"color:#FFA657\"> T</span><span style=\"color:#E6EDF3\">),</span><br><span style=\"color:#79C0FF\">  Err</span><span style=\"color:#E6EDF3\">(error</span><span style=\"color:#FF7B72\">:</span><span style=\"color:#FFA657\"> E</span><span style=\"color:#E6EDF3\">),</span><br><span style=\"color:#E6EDF3\">}</span><br><br><span style=\"color:#FF7B72\">const</span><span style=\"color:#79C0FF\"> value</span><span style=\"color:#FF7B72\"> =</span><span style=\"color:#E6EDF3\"> Result.</span><span style=\"color:#D2A8FF\">Ok</span><span style=\"color:#E6EDF3\">(</span><span style=\"color:#79C0FF\">42</span><span style=\"color:#E6EDF3\">);</span>",
  "match": "<span style=\"color:#FF7B72\">const</span><span style=\"color:#79C0FF\"> label</span><span style=\"color:#FF7B72\"> =</span><span style=\"color:#FF7B72\"> match</span><span style=\"color:#E6EDF3\"> (result) {</span><br><span style=\"color:#79C0FF\">  Ok</span><span style=\"color:#E6EDF3\">(value: </span><span style=\"color:#79C0FF\">Some</span><span style=\"color:#E6EDF3\">(value: user)) </span><span style=\"color:#FF7B72\">if</span><span style=\"color:#E6EDF3\"> user.active </span><span style=\"color:#FF7B72\">=></span><span style=\"color:#E6EDF3\"> user.name,</span><br><span style=\"color:#79C0FF\">  Ok</span><span style=\"color:#E6EDF3\">(value: </span><span style=\"color:#79C0FF\">None</span><span style=\"color:#E6EDF3\">()) </span><span style=\"color:#FF7B72\">=></span><span style=\"color:#A5D6FF\"> \"anonymous\"</span><span style=\"color:#E6EDF3\">,</span><br><span style=\"color:#79C0FF\">  Err</span><span style=\"color:#E6EDF3\">(error) </span><span style=\"color:#FF7B72\">=></span><span style=\"color:#E6EDF3\"> error.message,</span><br><span style=\"color:#FF7B72\">  _</span><span style=\"color:#FF7B72\"> =></span><span style=\"color:#A5D6FF\"> \"inactive\"</span><span style=\"color:#E6EDF3\">,</span><br><span style=\"color:#E6EDF3\">};</span>",
  "try": "<span style=\"color:#FF7B72\">import</span><span style=\"color:#FF7B72\"> type</span><span style=\"color:#E6EDF3\"> { TResult } </span><span style=\"color:#FF7B72\">from</span><span style=\"color:#A5D6FF\"> \"@rl/std\"</span><span style=\"color:#E6EDF3\">;</span><br><span style=\"color:#FF7B72\">import</span><span style=\"color:#79C0FF\"> *</span><span style=\"color:#FF7B72\"> as</span><span style=\"color:#E6EDF3\"> Result </span><span style=\"color:#FF7B72\">from</span><span style=\"color:#A5D6FF\"> \"@rl/std/result\"</span><span style=\"color:#E6EDF3\">;</span><br><br><span style=\"color:#FF7B72\">function</span><span style=\"color:#D2A8FF\"> load</span><span style=\"color:#E6EDF3\">(</span><span style=\"color:#FFA657\">id</span><span style=\"color:#FF7B72\">:</span><span style=\"color:#79C0FF\"> string</span><span style=\"color:#E6EDF3\">)</span><span style=\"color:#FF7B72\">:</span><span style=\"color:#FFA657\"> TResult</span><span style=\"color:#E6EDF3\">&#x3C;</span><span style=\"color:#FFA657\">User</span><span style=\"color:#E6EDF3\">, </span><span style=\"color:#FFA657\">LoadError</span><span style=\"color:#E6EDF3\">> {</span><br><span style=\"color:#FF7B72\">  const</span><span style=\"color:#79C0FF\"> raw</span><span style=\"color:#FF7B72\"> =</span><span style=\"color:#FF7B72\"> try</span><span style=\"color:#D2A8FF\"> read</span><span style=\"color:#E6EDF3\">(id);</span><br><span style=\"color:#FF7B72\">  const</span><span style=\"color:#79C0FF\"> user</span><span style=\"color:#FF7B72\"> =</span><span style=\"color:#FF7B72\"> try</span><span style=\"color:#D2A8FF\"> decode</span><span style=\"color:#E6EDF3\">(raw);</span><br><span style=\"color:#FF7B72\">  return</span><span style=\"color:#E6EDF3\"> Result.</span><span style=\"color:#D2A8FF\">Ok</span><span style=\"color:#E6EDF3\">(user);</span><br><span style=\"color:#E6EDF3\">}</span>",
  "let-else": "<span style=\"color:#FF7B72\">const</span><span style=\"color:#79C0FF\"> Some</span><span style=\"color:#E6EDF3\">(value: user) </span><span style=\"color:#FF7B72\">=</span><span style=\"color:#D2A8FF\"> findUser</span><span style=\"color:#E6EDF3\">(id) </span><span style=\"color:#FF7B72\">else</span><span style=\"color:#E6EDF3\"> {</span><br><span style=\"color:#FF7B72\">  return</span><span style=\"color:#E6EDF3\"> Result.</span><span style=\"color:#D2A8FF\">Err</span><span style=\"color:#E6EDF3\">(</span><span style=\"color:#A5D6FF\">\"not found\"</span><span style=\"color:#E6EDF3\">);</span><br><span style=\"color:#E6EDF3\">};</span>",
  "if-let": "<span style=\"color:#FF7B72\">if</span><span style=\"color:#FF7B72\"> let</span><span style=\"color:#79C0FF\"> Some</span><span style=\"color:#E6EDF3\">(value: user) </span><span style=\"color:#FF7B72\">=</span><span style=\"color:#E6EDF3\"> cache.</span><span style=\"color:#D2A8FF\">get</span><span style=\"color:#E6EDF3\">(id) {</span><br><span style=\"color:#D2A8FF\">  greet</span><span style=\"color:#E6EDF3\">(user);</span><br><span style=\"color:#E6EDF3\">} </span><span style=\"color:#FF7B72\">else</span><span style=\"color:#FF7B72\"> if</span><span style=\"color:#FF7B72\"> let</span><span style=\"color:#79C0FF\"> Some</span><span style=\"color:#E6EDF3\">(value: user) </span><span style=\"color:#FF7B72\">=</span><span style=\"color:#D2A8FF\"> fetchUser</span><span style=\"color:#E6EDF3\">(id) {</span><br><span style=\"color:#D2A8FF\">  greet</span><span style=\"color:#E6EDF3\">(user);</span><br><span style=\"color:#E6EDF3\">} </span><span style=\"color:#FF7B72\">else</span><span style=\"color:#E6EDF3\"> {</span><br><span style=\"color:#D2A8FF\">  prompt</span><span style=\"color:#E6EDF3\">();</span><br><span style=\"color:#E6EDF3\">}</span>",
  "pipe": "<span style=\"color:#FF7B72\">const</span><span style=\"color:#79C0FF\"> label</span><span style=\"color:#FF7B72\"> =</span><span style=\"color:#E6EDF3\"> input</span><br><span style=\"color:#FF7B72\">  |></span><span style=\"color:#E6EDF3\"> parse</span><br><span style=\"color:#FF7B72\">  |></span><span style=\"color:#E6EDF3\"> Option.</span><span style=\"color:#D2A8FF\">mapP</span><span style=\"color:#E6EDF3\">(</span><span style=\"color:#FFA657\">value</span><span style=\"color:#FF7B72\"> =></span><span style=\"color:#E6EDF3\"> value.</span><span style=\"color:#D2A8FF\">trim</span><span style=\"color:#E6EDF3\">())</span><br><span style=\"color:#FF7B72\">  |></span><span style=\"color:#E6EDF3\"> Option.</span><span style=\"color:#D2A8FF\">unwrapOrP</span><span style=\"color:#E6EDF3\">(</span><span style=\"color:#A5D6FF\">\"unknown\"</span><span style=\"color:#E6EDF3\">)</span><br><span style=\"color:#FF7B72\">  |></span><span style=\"color:#E6EDF3\"> .</span><span style=\"color:#D2A8FF\">toUpperCase</span><span style=\"color:#E6EDF3\">();</span>",
  "flow": "<span style=\"color:#FF7B72\">const</span><span style=\"color:#79C0FF\"> format</span><span style=\"color:#FF7B72\"> =</span><span style=\"color:#E6EDF3\"> flow</span><br><span style=\"color:#FF7B72\">  |></span><span style=\"color:#E6EDF3\"> parseNumber</span><br><span style=\"color:#FF7B72\">  |></span><span style=\"color:#E6EDF3\"> Option.</span><span style=\"color:#D2A8FF\">mapP</span><span style=\"color:#E6EDF3\">((</span><span style=\"color:#FFA657\">value</span><span style=\"color:#FF7B72\">:</span><span style=\"color:#79C0FF\"> number</span><span style=\"color:#E6EDF3\">) </span><span style=\"color:#FF7B72\">=></span><span style=\"color:#E6EDF3\"> value </span><span style=\"color:#FF7B72\">*</span><span style=\"color:#79C0FF\"> 2</span><span style=\"color:#E6EDF3\">)</span><br><span style=\"color:#FF7B72\">  |></span><span style=\"color:#E6EDF3\"> Option.</span><span style=\"color:#D2A8FF\">unwrapOrP</span><span style=\"color:#E6EDF3\">(</span><span style=\"color:#79C0FF\">0</span><span style=\"color:#E6EDF3\">)</span><br><span style=\"color:#FF7B72\">  |></span><span style=\"color:#E6EDF3\"> .</span><span style=\"color:#D2A8FF\">toFixed</span><span style=\"color:#E6EDF3\">(</span><span style=\"color:#79C0FF\">2</span><span style=\"color:#E6EDF3\">);</span><br><br><span style=\"color:#D2A8FF\">format</span><span style=\"color:#E6EDF3\">(</span><span style=\"color:#A5D6FF\">\"21\"</span><span style=\"color:#E6EDF3\">);</span>",
