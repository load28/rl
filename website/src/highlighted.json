  "option": "<span style=\"color:#FF7B72\">import</span><span style=\"color:#79C0FF\"> *</span><span style=\"color:#FF7B72\"> as</span><span style=\"color:#E6EDF3\"> Option </span><span style=\"color:#FF7B72\">from</span><span style=\"color:#A5D6FF\"> \"@rl/std/option\"</span><span style=\"color:#E6EDF3\">;</span><br><br><span style=\"color:#FF7B72\">const</span><span style=\"color:#79C0FF\"> port</span><span style=\"color:#FF7B72\"> =</span><span style=\"color:#E6EDF3\"> Option.</span><span style=\"color:#D2A8FF\">fromNullable</span><span style=\"color:#E6EDF3\">(env.</span><span style=\"color:#79C0FF\">PORT</span><span style=\"color:#E6EDF3\">)</span><br><span style=\"color:#FF7B72\">  |></span><span style=\"color:#E6EDF3\"> Option.</span><span style=\"color:#D2A8FF\">mapP</span><span style=\"color:#E6EDF3\">(Number)</span><br><span style=\"color:#FF7B72\">  |></span><span style=\"color:#E6EDF3\"> Option.</span><span style=\"color:#D2A8FF\">filterP</span><span style=\"color:#E6EDF3\">(Number.isFinite)</span><br><span style=\"color:#FF7B72\">  |></span><span style=\"color:#E6EDF3\"> Option.</span><span style=\"color:#D2A8FF\">unwrapOrP</span><span style=\"color:#E6EDF3\">(</span><span style=\"color:#79C0FF\">3000</span><span style=\"color:#E6EDF3\">);</span>",
