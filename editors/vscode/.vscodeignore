.vscode/**
**/*.ts
**/*.map
**/tsconfig.json
**/*.tsbuildinfo
# 문법은 생성물(syntaxes/rl.tmLanguage.json)만 패키징한다.
syntaxes/src/**
syntaxes/build.mjs
client/src/**
server/src/**
server/out/test/**
node_modules/**
!client/node_modules/vscode-languageclient/**
!server/node_modules/vscode-languageserver/**
!server/node_modules/vscode-languageserver-textdocument/**
!server/node_modules/vscode-languageserver-protocol/**
!server/node_modules/vscode-languageserver-types/**
!server/node_modules/vscode-jsonrpc/**
!server/node_modules/vscode-uri/**
# TypeScript itself is not packaged. The type answers come from the
# compiler's own language server (`tsgo`), which carries its lib*.d.ts
# inside its executable — nothing here has to ship them.
.gitignore
