.vscode/**
**/*.ts
**/*.map
**/tsconfig.json
**/*.tsbuildinfo
client/src/**
server/src/**
server/out/test/**
node_modules/**
!client/node_modules/vscode-languageclient/**
!server/node_modules/vscode-languageserver/**
!server/node_modules/vscode-languageserver-textdocument/**
!server/node_modules/vscode-languageserver-protocol/**
!server/node_modules/vscode-languageserver-types/**
!server/node_modules/vscode-jsonrpc/**
!server/node_modules/vscode-uri/**
# `**/*.ts` above matches declaration files too, which takes out TypeScript's
# own lib*.d.ts while leaving typescript.js in place — a language server that
# runs but type-checks against no globals at all, so it reports TS2488 on a
# plain tuple destructuring. `node_modules/**` does not reach these (it only
# matches the root node_modules), so this one line is the whole fix.
!server/node_modules/typescript/lib/lib*.d.ts
.gitignore
